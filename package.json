{
  "name": "gridlock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "dev": "npm run build:shared && concurrently -n server,client -c blue,green \"npm run dev -w @gridlock/server\" \"npm run dev -w @gridlock/client\"",
    "build:shared": "npm run build -w @gridlock/shared",
    "build": "npm run build -w @gridlock/shared && npm run build -w @gridlock/server && npm run build -w @gridlock/client",
    "start": "npm run start -w @gridlock/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b packages/shared packages/server packages/client",
    "loadtest": "npm run loadtest -w @gridlock/server",
    "soak": "npm run soak -w @gridlock/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}

# Server
# Hosting platforms assign PORT themselves; `--port` or GRIDLOCK_PORT override it.
PORT=2567
HOST=0.0.0.0
# Production: the server hosts the built client from packages/client/dist when
# it exists. CLIENT_DIST points it somewhere else.
CLIENT_DIST=
# Number of proxies in front of the server (3 on Render), so client addresses
# are read from X-Forwarded-For. 0 trusts no forwarded headers.
TRUST_PROXY=0
# Extra page origins allowed to open game connections, comma-separated ("*" for
# any). The server's own host is always allowed.
ALLOWED_ORIGINS=
# Most rooms the server holds at once (default from GAMEPLAY.net.maxRooms).
MAX_ROOMS=
TICK_HZ=30
SNAPSHOT_HZ=15
LOG_LEVEL=info

# Client (Vite) - where the browser connects for websockets.
# Leave unset in dev; the client derives it from window.location.
VITE_SERVER_URL=

# Reserved for later milestones (not used by the MVP - it runs fully in-memory)
# DATABASE_URL=postgres://gridlock:gridlock@localhost:5432/gridlock
# REDIS_URL=redis://localhost:6379
